# ==========================================================================
# Home TV – .gitignore
# Grundsatz: in Git liegt nur Quellcode, Dokumentation und die veröffentlichte APK (release/).
# Alles Lokale, Private und Erzeugte bleibt draußen.
# ==========================================================================

# --- Lokale Werkzeuge und Umgebungen (liegen im Projektordner, gehören nicht ins Repo) ---
.venv/
.gradle-home/
.android-sdk/
.android-user/
.gradle/
.kotlin/
tools/platform-tools/
tools/jdk/

# --- Build-Zwischendateien ---
build/*
!build/.gitkeep
app/build/
**/build/intermediates/
*.class
*.dex
local.properties
.idea/
*.iml
captures/

# --- Release-Signierung und Zugangsdaten (NIEMALS einchecken!) ---
# Ohne diesen Schlüssel kann niemand ein Update installieren, das sich "wie die alte App" signiert.
keystore/
*.jks
*.keystore
keystore.properties
signing.properties
.env
*.secret
credentials*.json

# --- Persönliche Konfiguration und Messdaten (enthält LAN-Adressen, Sender, Mitschnitte) ---
tests/data/
firetv-ip.txt
scripts/firetv.local.cfg
*.local.*

# --- Protokolle und Absturzberichte (enthalten Benutzernamen, Pfade, Umgebungsvariablen) ---
*.log
hs_err_pid*
replay_pid*
*.hprof

# --- Große Binärdateien und Mitschnitte ---
*.ts
*.mp4
*.mkv
*.aab
# APKs sind grundsätzlich ausgeschlossen ...
*.apk
# ... mit EINER Ausnahme: die veröffentlichte, signierte Release-APK(s) im Ordner release/
!release/
!release/HomeTV-*.apk

# --- Python ---
__pycache__/
*.pyc

# --- Betriebssystem / Editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json

# --- Notizen der KI-Assistenz (nicht veröffentlichen) ---
info.markdown
.claude/
